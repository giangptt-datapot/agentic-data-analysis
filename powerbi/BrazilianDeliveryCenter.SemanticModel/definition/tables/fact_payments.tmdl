table fact_payments
	lineageTag: tbl-fact-payments

	column payment_id
		dataType: int64
		summarizeBy: none
		sourceColumn: payment_id
		lineageTag: lt-payment_id
	column payment_order_id
		dataType: int64
		summarizeBy: none
		sourceColumn: payment_order_id
		lineageTag: lt-payment_order_id
	column payment_amount
		dataType: double
		summarizeBy: sum
		sourceColumn: payment_amount
		formatString: "R$"#,0.00
		lineageTag: lt-payment_amount
	column payment_fee
		dataType: double
		summarizeBy: sum
		sourceColumn: payment_fee
		lineageTag: lt-payment_fee
	column payment_method
		dataType: string
		summarizeBy: none
		sourceColumn: payment_method
		lineageTag: lt-payment_method
	column payment_status
		dataType: string
		summarizeBy: none
		sourceColumn: payment_status
		lineageTag: lt-payment_status

	measure 'Payments' = COUNTROWS(fact_payments)
		formatString: #,0
	measure 'Chargeback Orders' = CALCULATE(DISTINCTCOUNT(fact_payments[payment_order_id]), fact_payments[payment_status] = "CHARGEBACK")
		formatString: #,0
	measure 'Chargeback Rate' = DIVIDE([Chargeback Orders], [Total Orders])
		formatString: 0.000%

	partition fact_payments = m
		mode: import
		source =
			let
			    Src = Csv.Document(File.Contents(SourceFolder & "payments.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Head = Table.PromoteHeaders(Src, [PromoteAllScalars=true]),
			    Typ = Table.TransformColumnTypes(Head, {
			        {"payment_id", Int64.Type}, {"payment_order_id", Int64.Type},
			        {"payment_amount", type number}, {"payment_fee", type number},
			        {"payment_method", type text}, {"payment_status", type text}})
			in
			    Typ
