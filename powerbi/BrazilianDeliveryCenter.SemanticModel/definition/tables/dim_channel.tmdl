table dim_channel
	lineageTag: tbl-dim-channel

	column channel_id
		dataType: int64
		summarizeBy: none
		sourceColumn: channel_id
		lineageTag: lt-channel_id
	column channel_name
		dataType: string
		summarizeBy: none
		sourceColumn: channel_name
		lineageTag: lt-channel_name
	column channel_type
		dataType: string
		summarizeBy: none
		sourceColumn: channel_type
		lineageTag: lt-channel_type

	partition dim_channel = m
		mode: import
		source =
			let
			    Src = Csv.Document(File.Contents(SourceFolder & "channels.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Head = Table.PromoteHeaders(Src, [PromoteAllScalars=true]),
			    Typ = Table.TransformColumnTypes(Head, {{"channel_id", Int64.Type}, {"channel_name", type text}, {"channel_type", type text}})
			in
			    Typ
