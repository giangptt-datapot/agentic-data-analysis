relationship rel_store_orders
	fromColumn: fact_orders.store_id
	toColumn: dim_store.store_id

relationship rel_channel_orders
	fromColumn: fact_orders.channel_id
	toColumn: dim_channel.channel_id

relationship rel_hub_store
	fromColumn: dim_store.hub_id
	toColumn: dim_hub.hub_id

relationship rel_date_orders
	fromColumn: fact_orders.order_date
	toColumn: dim_date.Date

relationship rel_orders_deliveries
	fromColumn: fact_deliveries.delivery_order_id
	toColumn: fact_orders.order_id

relationship rel_orders_payments
	fromColumn: fact_payments.payment_order_id
	toColumn: fact_orders.order_id

relationship rel_driver_deliveries
	fromColumn: fact_deliveries.driver_id
	toColumn: dim_driver.driver_id
