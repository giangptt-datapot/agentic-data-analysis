{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "scatHubQuad",
  "position": {
    "x": 660,
    "y": 120,
    "z": 3010,
    "height": 320,
    "width": 596,
    "tabOrder": 2010
  },
  "visual": {
    "visualType": "scatterChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_hub"
                    }
                  },
                  "Property": "hub_name"
                }
              },
              "queryRef": "dim_hub.hub_name",
              "nativeQueryRef": "hub_name",
              "active": true
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_orders"
                    }
                  },
                  "Property": "Finished Orders"
                }
              },
              "queryRef": "fact_orders.Finished Orders",
              "nativeQueryRef": "Finished Orders"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_orders"
                    }
                  },
                  "Property": "Cancellation Rate"
                }
              },
              "queryRef": "fact_orders.Cancellation Rate",
              "nativeQueryRef": "Cancellation Rate"
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_orders"
                    }
                  },
                  "Property": "GMV"
                }
              },
              "queryRef": "fact_orders.GMV",
              "nativeQueryRef": "GMV"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Hub: Volume vs Cancel Rate'"
                }
              }
            }
          }
        }
      ]
    }
  }
}