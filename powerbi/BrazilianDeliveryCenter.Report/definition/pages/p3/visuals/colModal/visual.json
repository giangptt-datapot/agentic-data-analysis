{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "colModal",
  "position": {
    "x": 24,
    "y": 166,
    "z": 3000,
    "height": 250,
    "width": 410,
    "tabOrder": 2000
  },
  "visual": {
    "visualType": "columnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_driver"
                    }
                  },
                  "Property": "driver_modal"
                }
              },
              "queryRef": "dim_driver.driver_modal",
              "nativeQueryRef": "driver_modal"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_orders"
                    }
                  },
                  "Property": "Median Cycle (min)"
                }
              },
              "queryRef": "fact_orders.Median Cycle (min)",
              "nativeQueryRef": "Median Cycle (min)"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Cycle time theo đội xe'"
                }
              }
            }
          }
        }
      ]
    }
  }
}